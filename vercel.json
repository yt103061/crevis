{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "regions": ["hnd1"],
  "crons": [
    {
      "path": "/api/cron/check-lps",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/lp-discover",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/cron/nl-fetch",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/nl-issue",
      "schedule": "0 23 * * 4"
    },
    {
      "path": "/api/cron/lp-discover-v2",
      "schedule": "0 3 * * *"
    }
  ]
}
