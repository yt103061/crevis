NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI設定（'gemini' または 'claude'）
AI_PROVIDER=gemini

# Phase 1: Gemini（無料）
GEMINI_API_KEY=

# Phase 2以降: Claude（任意タイミングで切替）
ANTHROPIC_API_KEY=

# ストレージ
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
# R2パブリックURL（r2.devサブドメイン or カスタムドメイン）
CLOUDFLARE_R2_PUBLIC_URL=

# メール
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# 決済（Phase 2〜）
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# GitHub Actions連携（スクショ取得ワークフロー）
GITHUB_TOKEN=
GITHUB_REPO=

# Cron（Vercel Cron用シークレット）
CRON_SECRET=

# 管理
ADMIN_EMAIL=
NEXT_PUBLIC_APP_URL=


# LP自動発見（未設定時はデフォルトフィードを利用）
LP_DISCOVERY_FEEDS=
LP_DISCOVERY_LIMIT_PER_FEED=10
LP_DISCOVERY_MIN_SCORE=70

# NL号自動化
NL_AUTO_ARTICLE_COUNT=5
NL_AUTO_MIN_RELEVANCE=70
NL_AUTO_SEND=false
NL_FETCH_AUTO_SEED_SOURCES=true
