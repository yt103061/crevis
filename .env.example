# Public Supabase settings (required for login/signup on browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side Supabase service key (required for admin APIs and cron jobs)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin login guard
ADMIN_EMAIL=admin@example.com
# Optional: expose admin email to client for showing admin nav link in header
NEXT_PUBLIC_ADMIN_EMAIL=admin@example.com

# AI provider
AI_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Email delivery
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Cron security token
CRON_SECRET=change-me

# LP auto discovery feeds (comma-separated)
LP_DISCOVERY_FEEDS=
# 未設定時は主要プロダクト系RSSをデフォルト利用

LP_DISCOVERY_LIMIT_PER_FEED=10
LP_DISCOVERY_MIN_SCORE=70
LP_DISCOVERY_MIN_HEURISTIC_SCORE=55
LP_DISCOVERY_JP_ONLY=true
LP_DISCOVERY_REQUIRE_PERFORMANCE_SIGNAL=true
LP_DISCOVERY_USE_DEFAULT_FEEDS=true

# NL issue automation
NL_AUTO_ARTICLE_COUNT=5
NL_AUTO_MIN_RELEVANCE=70
NL_AUTO_SEND=false
# 有効時、ニュースレター収集時に推奨RSSソースを自動投入
NL_FETCH_AUTO_SEED_SOURCES=true
NL_FETCH_AUTO_SEED_ON_EMPTY_ONLY=true
