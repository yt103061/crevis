# Public Supabase settings (required for login/signup on browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side Supabase service key (required for admin APIs and cron jobs)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin login guard
ADMIN_EMAIL=admin@example.com

# AI provider
AI_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Email delivery
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Cron security token
CRON_SECRET=change-me

# LP auto discovery feeds (comma-separated)
LP_DISCOVERY_FEEDS=
LP_DISCOVERY_LIMIT_PER_FEED=10
LP_DISCOVERY_MIN_SCORE=70
